da9f:0%;--v47c095f9:50%;--v000e51f2:center;--v79d8fbfe:calc(-20svh * 50 / 100);--v3f9ca25a:false;"><!----><!----><!----></div><div class="block-layout block-layout--layout" style="--m-grid-template-rows:9.72vw auto 4.44vw auto 0px;--t-grid-template-rows:minmax(35px, auto) minmax(698px, auto) minmax(16px, auto) minmax(320px, auto) 1fr;--small-desktop-grid-template-rows:minmax(1.96vw, auto) minmax(0.90vw, auto) minmax(27.29vw, auto) minmax(4.08vw, auto) 4.49vw;--grid-template-rows:minmax(24px, auto) minmax(11px, auto) minmax(334px, auto) minmax(50px, auto) 1fr;--m-grid-template-columns:100.00%;--grid-template-columns:42.81% 14.62% 37.83% 4.74%;--m-block-min-height:auto;--t-block-min-height:514px;--small-desktop-block-min-height:auto;--block-min-height:474px;--v3f3138e2:1224px;--c27f45b8:360px;--v66d5c4a6:0 4.444444444444445vw;--v1984096a:0 16px;" data-v-6686dd9a=""><!--[--><!--[--><div class="layout-element layout-element--layout layout-element transition transition--slide" style="--text:left;--align:flex-start;--justify:flex-start;--m-element-margin:0 0 16px 0;--z-index:1;--grid-row:2/5;--grid-column:1/2;--m-grid-row:2/3;--m-grid-column:1/2;--v72f86ff9:395px;--v4c707db6:698px;" data-v-5636d6b6="" data-qa="layout-element-wrapper:z29hve" data-animation-state="active"><!--[--><!----><!----><!----><!----><!----><div class="text-box layout-element__component layout-element__component--GridTextBox" id="z29hve" data-v-5636d6b6="" style="--v2b806092:break-spaces;--v12d9d480:initial;--d294b058:break-spaces;" data-qa="gridtextbox:z29hve"><h1 dir="auto" style="color: rgb(10, 16, 21); --lineHeightDesktop: 1.3; --fontSizeDesktop: 32px; margin-bottom: 24px;">Makam Tua Lamaru (Nisan Bertulis)</h1><p dir="auto" class="body-large">Benda bersejarah ini dilindungi oleh undang-undang sebagai <strong>Struktur Cagar Budaya</strong>, namun terdapat tantangan dalam perawatan dan publikasinya sehingga sering kurang dikenal luas.</p><p dir="auto" class="body-large">Di bagian depan dan samping papan terlihat struktur makam yang terbuat dari material batu/bata dengan kondisi yang telah mengalami pelapukan. Situs ini dikelilingi oleh <strong>pepohonan dan vegetasi hutan yang cukup lebat</strong>, sehingga memberikan suasana alami dan asri. Keberadaan papan informasi dan struktur makam menunjukkan upaya pemerintah dalam memberikan informasi serta menjaga keberadaan peninggalan sejarah dan budaya di kawasan Lamaru.</p></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!--[--><!--]--><!--]--></div><div class="layout-element layout-element--layout layout-element transition transition--slide transition--root-hidden" style="--align:center;--justify:center;--m-element-margin:0 0 16px 0;--z-index:2;--grid-row:3/4;--grid-column:3/4;--m-grid-row:4/5;--m-grid-column:1/2;--v72f86ff9:334px;--v4c707db6:320px;" data-v-5636d6b6="" data-qa="layout-element-wrapper:z1webx"><!--[--><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div id="z1WEBX" class="image-wrapper image-wrapper--layout layout-element__component layout-element__component--GridImage" data-v-5636d6b6="" style="--d8599d80:334px;--v636e1b04:320px;" data-v-70c5c70b="" data-qa="gridimage:z1webx"><div rel="nofollow" title="" style="--v7007e7a5:initial;--v76f5f733:initial;--v52de0f10:initial;--v3f28ffbc:37.826797385620914vw;--v21b35439:27.287581699346404vw;--e3629ab6:center 50%;--d66f8f86:initial;--v6dfc834f:100%;--v655f79f4:auto;" class="image image--grid loaded image-wrapper--desktop" data-selector="data-image" data-animation-role="image" data-v-70c5c70b="" data-v-8ca41215="" data-qa="grid-image" data-animation-state="active"><img alt="" src="./cagar8-hero_files/img_0237-kqlQNTvNy6GAmYZU.JPG" srcset="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=375,h=271,fit=crop/bNGQiIdhT9m59ywa/img_0237-kqlQNTvNy6GAmYZU.JPG 328w,https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,h=554,fit=crop/bNGQiIdhT9m59ywa/img_0237-kqlQNTvNy6GAmYZU.JPG 6