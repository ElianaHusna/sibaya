&quot;],&quot;m-element-margin&quot;:[0,&quot;0 0 16px 0&quot;]}],&quot;clickAction&quot;:[0,&quot;none&quot;]}],&quot;animation&quot;:[0,{&quot;name&quot;:[0,&quot;slide&quot;],&quot;type&quot;:[0,&quot;global&quot;]}],&quot;initialElementId&quot;:[0,&quot;zPBKZf&quot;],&quot;fullResolutionWidth&quot;:[0,3240],&quot;fullResolutionHeight&quot;:[0,2160]}],&quot;z29hve&quot;:[0,{&quot;type&quot;:[0,&quot;GridTextBox&quot;],&quot;mobile&quot;:[0,{&quot;top&quot;:[0,35],&quot;left&quot;:[0,0],&quot;width&quot;:[0,328],&quot;height&quot;:[0,698]}],&quot;content&quot;:[0,&quot;&lt;h1 dir=\&quot;auto\&quot; style=\&quot;color: rgb(10, 16, 21); --lineHeightDesktop: 1.3; --fontSizeDesktop: 32px; margin-bottom: 24px;\&quot;&gt;Makam Tua Lamaru (Nisan Bertulis)&lt;/h1&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body-large\&quot;&gt;Benda bersejarah ini dilindungi oleh undang-undang sebagai &lt;strong&gt;Struktur Cagar Budaya&lt;/strong&gt;, namun terdapat tantangan dalam perawatan dan publikasinya sehingga sering kurang dikenal luas.&lt;/p&gt;&lt;p dir=\&quot;auto\&quot; class=\&quot;body-large\&quot;&gt;Di bagian depan dan samping papan terlihat struktur makam yang terbuat dari material batu/bata dengan kondisi yang telah mengalami pelapukan. Situs ini dikelilingi oleh &lt;strong&gt;pepohonan dan vegetasi hutan yang cukup lebat&lt;/strong&gt;, sehingga memberikan suasana alami dan asri. Keberadaan papan informasi dan struktur makam menunjukkan upaya pemerintah dalam memberikan informasi serta menjaga keberadaan peninggalan sejarah dan budaya di kawasan Lamaru.&lt;/p&gt;&quot;],&quot;desktop&quot;:[0,{&quot;top&quot;:[0,24],&quot;left&quot;:[0,0],&quot;width&quot;:[0,524],&quot;height&quot;:[0,395]}],&quot;settings&quot;:[0,{&quot;styles&quot;:[0,{&quot;text&quot;:[0,&quot;left&quot;],&quot;align&quot;:[0,&quot;flex-start&quot;],&quot;justify&quot;:[0,&quot;flex-start&quot;],&quot;m-element-margin&quot;:[0,&quot;0 0 16px 0&quot;]}]}],&quot;animation&quot;:[0,{&quot;name&quot;